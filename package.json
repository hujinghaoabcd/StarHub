{
  "name": "starhub",
  "version": "1.0.0",
  "description": "A professional GitHub Stars management application with beautiful UI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "lint:fix": "npm run lint -- --fix",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:sync": "npm run test:unit",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "security:verify": "node scripts/verify-static-security.mjs",
    "check": "npm run lint && npm run type-check && npm run test:unit && npm run cloudflare:type-check && npm run pages:build && npm run security:verify && npm run audit:production && npm run cloudflare:build",
    "pages:build": "node scripts/build-pages.mjs",
    "cloudflare:build": "node scripts/build-cloudflare.mjs",
    "cloudflare:type-check": "tsc -p functions/tsconfig.json --noEmit",
    "cloudflare:dev": "npm run cloudflare:build && npx wrangler pages dev cloudflare-dist",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.19.0",
    "dexie": "^3.2.4",
    "dompurify": "^3.4.12",
    "element-plus": "^2.5.6",
    "github-markdown-css": "^5.8.1",
    "highlight.js": "^11.10.0",
    "http-link-header": "^1.0.2",
    "marked": "^17.0.1",
    "marked-gfm-heading-id": "^4.1.3",
    "marked-highlight": "^2.2.3",
    "marked-mangle": "^1.1.12",
    "pinia": "^2.1.7",
    "query-string": "^9.1.0",
    "vue": "^3.4.21",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.3.0",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "sass": "^1.102.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
